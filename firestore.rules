rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function directConversationId(uidA, uidB) {
      return uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /directConversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && conversationId == directConversationId(request.resource.data.participants[0], request.resource.data.participants[1]);
      allow update, delete: if false;
    }

    match /groups/{groupId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= request.resource.data.memberLimit;
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds.size() <= request.resource.data.memberLimit;
      allow delete: if false;
    }
  }
}
