{
  "expo": {
    "name": "WhatChat",
    "slug": "whatchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whatchat.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "O WhatChat usa sua galeria para selecionar fotos de perfil e de grupo."
      }
    },
    "android": {
      "package": "com.whatchat.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0B1017",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O WhatChat usa sua galeria para selecionar fotos de perfil e de grupo."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4C8DFF"
        }
      ]
    ],
    "backgroundColor": "#0B1017"
  }
}
